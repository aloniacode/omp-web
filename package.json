{
  "name": "omp-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "description": "Web UI for the oh-my-pi coding agent (interface + RPC bridge only)",
  "scripts": {
    "dev": "concurrently -k -n bridge,vite -c yellow,cyan \"node server/bridge.mjs\" \"vite\"",
    "bridge": "node server/bridge.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/bridge.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "highlight.js": "^11.11.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.0",
    "ws": "^8.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
